<body>
<main>
<header>
  <h1>A Christ-Centered Christmas</h1>
  <p class="sub">The birth, mission, and infinite love of our Saviour, Jesus Christ</p>
  <div class="tools">
    <button onclick="sz(-2)">A−</button>
    <button onclick="sz(2)">A+</button>
    <button onclick="document.documentElement.dataset.theme=document.documentElement.dataset.theme==='dark'?'light':'dark'">Light / Dark</button>
  </div>
